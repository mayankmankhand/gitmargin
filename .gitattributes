# Auto-detect text files and normalize line endings
* text=auto

# Force LF line endings for shell scripts and toolkit scripts
# Prevents CRLF on Windows clones from breaking bash execution and Node shebangs
*.sh text eol=lf
scripts/** text eol=lf
# The plugin's sh launchers and its publishing script: a CRLF on a Windows clone breaks the launchers
plugin/bin/* text eol=lf
plugin/scripts/** text eol=lf
